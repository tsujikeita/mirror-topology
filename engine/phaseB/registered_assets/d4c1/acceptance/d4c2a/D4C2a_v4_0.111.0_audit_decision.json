  "findings": [
    {
      "id": "R-D4BRIDGE-A-PRODUCER-PROVENANCE",
      "status": "OPEN_BLOCKING_BRIDGE_COMPARATOR_ACCEPTANCE",
      "location": "d/d4c2_bridge_compare.py:92-113; _unpack",
      "finding": "The new comparator validates the received 24-name list against the received gate dict, not the producer script REQUIRED_PARTIAL. Renaming G_inputs_resolved in both is accepted. Wrong source pins, different attempt id, malformed lock/failure final, and failed/injected twelve gate are also accepted. Lock/final/precheck/prelaunch are not read.",
      "required_change": "AST-extract the trusted REQUIRED_PARTIAL from the approved PRODUCER tree (0.110.0), compare exact names and strict booleans, bind source pins/top-level metadata to actual trusted files, verify lock/final/attempt/run/publication and precheck/prelaunch including the live twelve gate against the fixed producer GO. Keep per-row/own-reader checks. Do not import the 0.111 reader in place of the producer reader."
    },
    {
      "id": "R-D4BRIDGE-B-TYPED-INDEX-IDENTITY",
      "status": "OPEN_BLOCKING_BRIDGE_COMPARATOR_ACCEPTANCE",
      "location": "d/d4c2_bridge_compare.py:132-159",
      "finding": "The typed-identity claim is not enforced: replacing pseudo_index=0 by JSON false in a family_result index entry leaves all comparisons and own reader successful. Record bytes remain unchanged; Python value equality conflates bool and int.",
      "required_change": "Compare complete archive identities to the specification using a local, recursive type-strict comparator; require integer non-bool global row ids and exactly matched row/size/identity inventories. Keep original 15 content hashes/bytes unchanged. Implement the helper in the comparator so it works with the 0.110 producer tree."
    },
    {
      "id": "R-D4BRIDGE-C-PROFILE-DOCUMENT",
      "status": "OPEN_BLOCKING_BRIDGE_COMPARATOR_ACCEPTANCE",
      "location": "d/d4c2_bridge_compare.py:104-106",
      "finding": "A rehashed profile declaring missing_targets=[TEST_MISSING_TARGET] and cprofile=False is accepted when the run summary still says missing_targets=[] and segments=3. Actual profile metadata/coverage are not reconciled.",
      "required_change": "Validate the actual profile document: missing_targets=[], instrumentation flags, the producer TARGETS inventory, count and per_segment coverage/indices, and equality with the run summary and receipt. Use a structurally complete valid profile fixture; SHA consistency alone is not semantic consistency."
    }
  ],
